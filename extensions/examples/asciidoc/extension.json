{
  "id": "panda.sample-asciidoc",
  "version": "1.0.0",
  "displayName": "AsciiDoc 示例扩展",
  "description": "为 .adoc 文件提供源码编辑与内联预览示例。",
  "engines": { "panda": "^0.1.0" },
  "main": "dist/extension.js",
  "activationEvents": ["onFormat:asciidoc", "onCommand:asciidoc.exportHtml"],
  "permissions": ["workspace:read"],
  "contributes": {
    "formats": [
      {
        "id": "asciidoc",
        "extensions": [".adoc", ".asciidoc"],
        "capabilities": {
          "source": true,
          "wysiwyg": false,
          "preview": "inline",
          "outline": false,
          "exportHtml": true
        },
        "language": "asciidoc"
      }
    ],
    "languages": [
      {
        "id": "asciidoc",
        "extensions": [".adoc", ".asciidoc"],
        "syntax": "plain",
        "commentTokens": { "line": "//" },
        "folding": "indentation"
      }
    ],
    "commands": [{ "id": "asciidoc.exportHtml", "title": "AsciiDoc: 导出 HTML（示例）" }],
    "configuration": {
      "asciidoc.strict": { "type": "boolean", "default": false }
    }
  }
}
