{
  "appId": "com.pandalive.app",
  "productName": "Panda Live",
  "asar": true,
  "electronDist": "node_modules/electron/dist",
  "directories": {
    "output": "release"
  },
  "files": [
    "dist/**/*",
    "dist-electron/**/*",
    "extensions/**/*",
    "!node_modules/**/*"
  ],
  "win": {
    "target": ["nsis"]
  },
  "mac": {
    "target": ["dmg"],
    "category": "public.app-category.productivity"
  },
  "linux": {
    "target": ["AppImage"]
  }
}
