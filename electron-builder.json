{
  "appId": "com.pandalive.app",
  "productName": "Panda Live",
  "asar": true,
  "electronDist": "node_modules/electron/dist",
  "directories": {
    "output": "release"
  },
  "files": [
    "dist/**/*",
    "dist-electron/**/*",
    "extensions/**/*",
    "!node_modules/**/*"
  ],
  "extraResources": [
    {
      "from": "build/tectonic",
      "to": "tectonic"
    }
  ],
  "win": {
    "target": ["nsis"],
    "icon": "build/icon.ico"
  },
  "mac": {
    "target": ["dmg"],
    "category": "public.app-category.productivity",
    "icon": "build/icon.png"
  },
  "linux": {
    "target": ["AppImage"],
    "icon": "build/icon.png"
  }
}
