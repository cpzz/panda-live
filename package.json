{
  "name": "panda-live",
  "version": "0.1.0",
  "private": true,
  "description": "Panda Live — 本地优先的桌面文档编辑器",
  "author": "Panda Live",
  "license": "Apache-2.0",
  "type": "module",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "vite --config vite.config.electron.ts",
    "build": "npm run typecheck && vite build --config vite.config.electron.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "node scripts/run-vitest.cjs run",
    "test:e2e": "playwright test",
    "verify": "npm run lint && npm run test && npm run build",
    "win": "electron .",
    "package": "node scripts/ensure-electron.cjs && npm run build && node scripts/prepare-tectonic.cjs && node scripts/build-installer.cjs"
  },
  "dependencies": {
    "@codemirror/lang-cpp": "^6.0.3",
    "@codemirror/lang-css": "^6.3.1",
    "@codemirror/lang-html": "^6.4.12",
    "@codemirror/lang-java": "^6.0.2",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/lang-php": "^6.0.2",
    "@codemirror/lang-python": "^6.2.1",
    "@codemirror/lang-rust": "^6.0.2",
    "@codemirror/lang-sql": "^6.10.0",
    "@codemirror/lang-xml": "^6.1.0",
    "@codemirror/lang-yaml": "^6.1.3",
    "@codemirror/legacy-modes": "^6.5.5",
    "@codemirror/search": "^6.7.2",
    "@jvmr/pptx-to-html": "^1.1.2",
    "@lezer/highlight": "^1.2.5",
    "@plantuml/core": "^1.2026.9",
    "chokidar": "^6.0.0",
    "codemirror": "^6.0.2",
    "diff": "^8.0.4",
    "docx-preview": "^0.4.1",
    "dompurify": "^3.4.17",
    "jszip": "^3.10.2",
    "katex": "^0.19.1",
    "mathlive": "^0.111.4",
    "mermaid": "^11.17.2",
    "node-tectonic": "1.1.0",
    "pdfjs-dist": "^6.5.438",
    "prosemirror-commands": "^1.7.2",
    "prosemirror-dropcursor": "^1.8.4",
    "prosemirror-gapcursor": "^1.4.1",
    "prosemirror-history": "^1.5.1",
    "prosemirror-inputrules": "^1.5.1",
    "prosemirror-keymap": "^1.2.3",
    "prosemirror-model": "^1.25.12",
    "prosemirror-schema-list": "^1.6.0",
    "prosemirror-state": "^1.4.4",
    "prosemirror-tables": "^1.8.5",
    "prosemirror-view": "^1.42.9",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "rehype-katex": "^7.0.1",
    "rehype-stringify": "^10.0.1",
    "remark-frontmatter": "^5.0.0",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "remark-stringify": "^11.0.0",
    "semver": "^7.8.6",
    "shiki": "^4.6.0",
    "unified": "^11.0.5",
    "xlsx": "^0.18.5",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/semver": "^7.8.0",
    "@vitejs/plugin-react": "^6.2.1",
    "electron": "^45.2.3",
    "electron-builder": "^26.18.0",
    "eslint": "^10.15.0",
    "jsdom": "^31.0.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.6",
    "vite-plugin-electron": "^1.2.0",
    "vitest": "^5.1.0"
  },
  "allowScripts": {
    "electron": true,
    "electron-winstaller@5.4.0": true
  }
}
